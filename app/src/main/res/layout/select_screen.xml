<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FAFAFA">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Card for Station Selection -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Station"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                <AutoCompleteTextView
                        android:id="@+id/stationAutoComplete"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:inputType="text"
                        android:dropDownHeight="200dp"
                        android:dropDownVerticalOffset="8dp"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Card for Distance -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance (km)"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                <EditText
                        android:id="@+id/minDistanceEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Minimum"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="8dp"/>

                <EditText
                        android:id="@+id/maxDistanceEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Maximum (optional)"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card for Weighted Values -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <!-- Bus Weight -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bus Station Weight (0 - 1)"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                <EditText
                        android:id="@+id/busWeightEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 0.5"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="8dp"/>

                <!-- Tram Weight -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tram Station Weight (0 - 1)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>

                <EditText
                        android:id="@+id/tramWeightEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 0.5"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card for Number of Results -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Number of Results"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                <EditText
                        android:id="@+id/numStationsEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 3"
                        android:inputType="number"
                        android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Submit Button -->
        <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find Stations"
                android:textStyle="bold"
                android:backgroundTint="#6200EE"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>
    </LinearLayout>
</ScrollView>